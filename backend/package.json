{
  "name": "padi-loan-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --outdir=dist --target=bun",
    "db:push": "drizzle-kit push",
    "db:kui": "drizzle-kit generate && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.0",
    "jose": "^6.1.3",
    "postgres": "^3.4.8",
    "ua-parser-js": "^2.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5"
  }
}
